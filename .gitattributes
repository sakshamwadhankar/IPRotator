# Let git normalise ordinary text files.
*        text=auto

# Windows scripts must keep CRLF line endings: cmd.exe can misread .bat files
# with Unix (LF) endings. This forces CRLF on checkout, whatever the user's
# git settings are.
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf
*.psm1   text eol=crlf
*.psd1   text eol=crlf

# Binary files: never touch.
*.png    binary
*.jpg    binary
*.gif    binary
*.ico    binary
